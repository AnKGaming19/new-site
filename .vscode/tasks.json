{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-and-serve",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^never matches$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> aianchor-website@.*dev",
                    "endsPattern": "^\\s*api\\s+.*http://localhost:[0-9]+/?$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
