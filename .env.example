# Copy to .env.local for local runs (`vercel dev`), and set the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.
# .env / .env.local are gitignored; this example file is not.

# Resend API key — powers /api/book-demo (free-demo confirmation + lead notification).
# Create it at https://resend.com/api-keys with "Sending access".
# The sending domain (aianchor.online) must be verified in Resend, otherwise
# the info@aianchor.online sender is rejected.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — inbox that receives the internal "new demo request" notification.
# Defaults to info@aianchor.online when unset.
DEMO_NOTIFY_EMAIL=info@aianchor.online

# Anthropic API key — powers /api/chat, the "Anchor" support assistant in the corner
# of every page. Create it at https://console.anthropic.com/settings/keys.
# Without it the endpoint returns 503 and the widget shows its "offline" message,
# so the rest of the site is unaffected if the key is missing or revoked.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — model the assistant runs on. Defaults to claude-opus-5.
# Set claude-sonnet-5 for a cheaper/faster assistant at some loss of nuance.
# Note: claude-haiku-4-5 works too, but it does not support the effort parameter, so
# /api/chat drops that tuning automatically for it.
# ANTHROPIC_MODEL=claude-opus-5
